---
import '../styles/global.css';
const { title = 'Расписание ДГТУ', description = 'Расписание занятий в Telegram для студентов и преподавателей ДГТУ.' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f6f7" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href="/"><i aria-hidden="true"></i>Расписание ДГТУ</a>
      <nav aria-label="Основная навигация">
        <a href="/#help">Помощь</a><a href="/updates/">Обновления</a><a href="/tech/">Как устроено</a>
      </nav>
    </header>
    <slot />
    <footer class="wrap footer">
      <span>Расписание ДГТУ · справочная страница</span>
      <a href="/updates/">История изменений</a>
    </footer>
    <script is:inline>
      if (window.Telegram?.WebApp) {
        const app = window.Telegram.WebApp;
        app.ready();
        app.expand();
        const theme = app.themeParams || {};
        const styles = document.documentElement.style;
        const colors = {
          paper: theme.bg_color,
          ink: theme.text_color,
          muted: theme.hint_color,
          line: theme.section_separator_color || theme.hint_color,
          blue: theme.link_color,
          white: theme.secondary_bg_color,
          card: theme.secondary_bg_color,
          soft: theme.secondary_bg_color,
        };
        for (const [name, color] of Object.entries(colors)) {
          if (color) styles.setProperty(`--${name}`, color);
        }
      }
    </script>
  </body>
</html>
